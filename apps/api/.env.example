# Database
DATABASE_URL=postgresql://maintainium:maintainium_dev@localhost:5433/maintainium

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Encryption (32-byte hex key for AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Webhook base URL (public URL where GitHub can reach your API)
# Local dev: use ngrok (e.g., https://abc123.ngrok.io)
# Production: your API domain (e.g., https://api.maintainium.com)
WEBHOOK_BASE_URL=http://localhost:4000

#LLM Configuration (optional — analysis works without these, LLM phases are skipped)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5-20250929
LLM_API_KEY=
